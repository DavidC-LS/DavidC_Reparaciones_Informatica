<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- Registro de los clientes  -->
<record id="vista_lista_clientes" model="ir.ui.view">
    <field name="name">bytefix.cliente.list</field>
    <field name="model">bytefix.cliente</field>
    <field name="arch" type="xml">
        <list string="Clientes">
            <field name="nombre"/>
            <field name="apellidos"/>
            <field name="email"/>
        </list>
    </field>
</record>
<!-- Vista de formulario -->
<record id="vista_formulario_clientes" model="ir.ui.view">
    <field name="name">bytefix.cliente.form</field>
    <field name="model">bytefix.cliente</field>
    <field name="arch" type="xml">
        <form string="Cliente">
            <sheet>
                <group>
                    <field name="nombre"/>
                    <field name="apellidos"/>
                    <field name="email"/>
                    <field name="direccion"/>
                    <field name="telefono"/>
                    <field name="fecha_alta"/>
                    <field name="habitual"/>
                    <field name="foto"/>
                    <field name="notas"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
<!-- Accion-->
<record id="accion_clientes" model="ir.actions.act_window">
    <field name="name">Clientes</field>
    <field name="res_model">bytefix.cliente</field>
    <field name="view_mode">list,form</field>
</record>

<!-- Menu entrada principal-->
<menuitem id="menu_bytefix_root" name="ByteFix"/>

<!-- Menu opcion clientes-->
<menuitem id="menu_bytefix_clientes"
          name="Clientes"
          parent="menu_bytefix_root"
          action="accion_clientes"/>


</odoo>