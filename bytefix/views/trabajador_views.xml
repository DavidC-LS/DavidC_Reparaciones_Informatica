<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 <!-- Vista de lista -->
    <record id="vista_lista_trabajadores" model="ir.ui.view">
        <field name="name">bytefix.trabajador.list</field>
        <field name="model">bytefix.trabajador</field>
        <field name="arch" type="xml">
            <list string="Trabajadores">
                <field name="nombre"/>
                <field name="apellido"/>
                <field name="telefono"/>
            </list>
        </field>
    </record>

      <!-- Vista de formulario -->
    <record id="vista_formulario_trabajadores" model="ir.ui.view">
        <field name="name">bytefix.trabajador.form</field>
        <field name="model">bytefix.trabajador</field>
        <field name="arch" type="xml">
            <form string="Trabajador">
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="apellido"/>
                        <field name="email"/>
                        <field name="dni"/>
                        <field name="telefono"/>
                        <field name="fecha_contratacion"/>
                        <field name="activo"/>
                        <field name="foto"/>
                        <field name="especialidad"/>
                        <field name="salario"/>
                        <field name="observaciones"/>
                        <field name="reparacion_ids"/>
                    </group>
                </sheet>
            </form>   
        </field>
    </record>  

    
    <!-- Vista de busqueda -->
<record id="vista_busqueda_trabajadores" model="ir.ui.view">
    <field name="name">bytefix.trabajadores.search</field>
    <field name="model">bytefix.trabajador</field>
    <field name="arch" type="xml">
        <search string = "Buscar Trabajadores">
            <field name="nombre"/>
            <field name="apellido"/>
           
            <filter name="activos"
                    string="Trabajadores en activo"
                    domain="[('activo', '=', True)]"/>

            <group>
                <filter name="agrupar_especialidad" string="Especialidades"
                            context="{'group_by': 'especialidad'}"/>
            </group>
            
        </search>
    </field>
</record>

 <!-- Acción -->
    <record id="accion_trabajadores" model="ir.actions.act_window">
        <field name="name">Trabajadores</field>
        <field name="res_model">bytefix.trabajador</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="vista_busqueda_trabajadores"/>
    </record>

     <!-- Menú -->
    <menuitem id="menu_bytefix_trabajadores"
          name="Trabajadores"
          parent="menu_bytefix_root"
          action="accion_trabajadores"/>

</odoo>
