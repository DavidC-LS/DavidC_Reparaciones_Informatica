<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 <!-- Vista de lista -->
    <record id="vista_lista_trabajadores" model="ir.ui.view">
        <field name="name">bytefix.trabajador.list</field>
        <field name="model">bytefix.trabajador</field>
        <field name="arch" type="xml">
            <list string="Trabajadores">
                <field name="nombre"/>
                <field name="apellido"/>
                <field name="telefono"/>
            </list>
        </field>
    </record>

      <!-- Vista de formulario -->
    <record id="vista_formulario_trabajadores" model="ir.ui.view">
        <field name="name">bytefix.trabajador.form</field>
        <field name="model">bytefix.trabajador</field>
        <field name="arch" type="xml">
            <form string="Trabajador">
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="apellido"/>
                        <field name="email"/>
                        <field name="dni"/>
                        <field name="telefono"/>
                        <field name="fecha_contratacion"/>
                        <field name="activo"/>
                        <field name="foto"/>
                        <field name="especialidad"/>
                        <field name="salario"/>
                        <field name="observaciones"/>
                        <field name="reparacion_ids"/>
                    </group>
                </sheet>
            </form>   
        </field>
    </record>  

 <!-- Acción -->
    <record id="accion_trabajadores" model="ir.actions.act_window">
        <field name="name">Trabajadores</field>
        <field name="res_model">bytefix.trabajador</field>
        <field name="view_mode">list,form</field>
    </record>

     <!-- Menú -->
    <menuitem id="menu_bytefix_trabajadores"
          name="Trabajadores"
          parent="menu_bytefix_root"
          action="accion_trabajadores"/>

</odoo>
