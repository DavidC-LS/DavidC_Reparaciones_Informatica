<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- Registro de los equipos  -->
<record id="vista_lista_equipos" model="ir.ui.view">
    <field name="name">bytefix.equipo.list</field>
    <field name="model">bytefix.equipo</field>
    <field name="arch" type="xml">
        <list string="Equipos">
            <field name="nombre"/>
            <field name="marca"/>
            <field name="modelo"/>
        </list>
    </field>
</record>

<!-- Vista de formulario -->
<record id="vista_formulario_equipos" model="ir.ui.view">
    <field name="name">bytefix.equipo.form</field>
    <field name="model">bytefix.equipo</field>
    <field name="arch" type="xml">
        <form string="Equipo">
            <sheet>
                <group>
                    <field name="nombre"/>
                    <field name="numero_serie"/>
                    <field name="marca"/>
                    <field name="modelo"/>
                    <field name="tipo"/>
                    <field name="fecha_compra"/>
                    <field name="garantia"/>
                    <field name="imagen"/>
                    <field name="observaciones"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

    <!-- Vista de busqueda -->
<record id="vista_busqueda_equipos" model="ir.ui.view">
    <field name="name">bytefix.equipos.search</field>
    <field name="model">bytefix.equipo</field>
    <field name="arch" type="xml">
        <search string = "Buscar Equipos">
            <field name="marca"/>
            <field name="modelo"/>
           
            <filter name="Garantia"
                    string="Equipos en garantia"
                    domain="[('garantia', '=', True)]"/>

            <group>
                <filter name="agrupar_tipo" string="Tipos"
                            context="{'group_by': 'tipo'}"/>
            </group>
            
        </search>
    </field>
</record>

<!-- Accion-->
<record id="accion_equipos" model="ir.actions.act_window">
    <field name="name">Equipos</field>
    <field name="res_model">bytefix.equipo</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="vista_busqueda_equipos"/>
</record>



<!-- Menu opcion equipos-->
<menuitem id="menu_bytefix_equipos"
          name="Equipos"
          parent="menu_bytefix_root"
          action="accion_equipos"/>


</odoo>